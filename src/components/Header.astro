---
import Link from '@/components/Link.astro'
import ThemeToggle from '@/components/ThemeToggle.astro'
import { NAV_LINKS, SITE } from '@/consts'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import logo from '../../public/static/logo.svg'
---

<div class="border-border/70 border-b">
  <div
    class="mx-auto flex min-h-14 max-w-3xl items-center justify-between gap-3 px-4 py-3"
  >
    <Link
      href="/"
      class="flex min-w-0 items-center justify-center gap-3"
      aria-label={`${SITE.title} — Home`}
    >
      <Image src={logo} alt="Logo" class="size-5 sm:size-6" />
      <span class="truncate text-base leading-none font-medium sm:text-lg"
        >{SITE.title}</span
      >
    </Link>
    <div class="flex shrink-0 items-center gap-1 sm:gap-3">
      <nav
        class="hidden items-center gap-6 text-sm md:flex"
        aria-label="Primary navigation"
      >
        {
          NAV_LINKS.map((item) => (
            <Link
              href={item.href}
              class="text-foreground/60 hover:text-foreground capitalize transition-colors"
            >
              {item.label}
            </Link>
          ))
        }
      </nav>
      <ThemeToggle transition:persist />
      <button
        id="mobile-menu-toggle"
        type="button"
        class="hover:bg-muted -my-2 -me-2 inline-flex size-9 items-center justify-center rounded-md transition-colors md:hidden"
        aria-label="Open navigation menu"
        aria-controls="mobile-navigation"
        aria-expanded="false"
      >
        <Icon data-menu-open name="lucide:menu" class="size-5" />
        <Icon data-menu-close name="lucide:x" class="hidden size-5" />
      </button>
    </div>
  </div>

  <nav
    id="mobile-navigation"
    class="border-border/70 bg-background hidden border-t px-4 py-2 md:hidden"
    aria-label="Mobile navigation"
  >
    <div class="mx-auto grid max-w-3xl gap-1">
      {
        NAV_LINKS.map((item) => (
          <Link
            href={item.href}
            class="hover:bg-muted rounded-md px-3 py-2.5 text-sm font-medium capitalize transition-colors"
          >
            {item.label}
          </Link>
        ))
      }
    </div>
  </nav>
</div>

<script>
  function setMobileMenuOpen(open: boolean) {
    const toggle = document.getElementById('mobile-menu-toggle')
    const menu = document.getElementById('mobile-navigation')

    if (!(toggle instanceof HTMLButtonElement) || !menu) return

    const openIcon = toggle.querySelector('[data-menu-open]')
    const closeIcon = toggle.querySelector('[data-menu-close]')

    toggle.setAttribute('aria-expanded', String(open))
    toggle.setAttribute(
      'aria-label',
      open ? 'Close navigation menu' : 'Open navigation menu',
    )
    menu.classList.toggle('hidden', !open)
    openIcon?.classList.toggle('hidden', open)
    closeIcon?.classList.toggle('hidden', !open)
  }

  function initMobileMenu() {
    const toggle = document.getElementById('mobile-menu-toggle')
    const menu = document.getElementById('mobile-navigation')

    if (!(toggle instanceof HTMLButtonElement) || !menu) return
    if (toggle.dataset.initialized === 'true') return
    toggle.dataset.initialized = 'true'

    toggle.addEventListener('click', () => {
      setMobileMenuOpen(toggle.getAttribute('aria-expanded') !== 'true')
    })

    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setMobileMenuOpen(false)
    })
  }

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return

    const toggle = document.getElementById('mobile-menu-toggle')
    setMobileMenuOpen(false)
    toggle?.focus()
  })

  document.addEventListener('click', (event) => {
    const toggle = document.getElementById('mobile-menu-toggle')
    const menu = document.getElementById('mobile-navigation')
    const target = event.target as Node

    if (!toggle?.contains(target) && !menu?.contains(target)) {
      setMobileMenuOpen(false)
    }
  })

  window.matchMedia('(min-width: 768px)').addEventListener('change', () => {
    setMobileMenuOpen(false)
  })

  initMobileMenu()
  document.addEventListener('astro:after-swap', initMobileMenu)
</script>
